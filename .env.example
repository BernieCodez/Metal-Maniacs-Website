# ══════════════════════════════════════════════
#  Metal Maniacs — Competition Host .env
#  Copy this to .env and fill in your values
# ══════════════════════════════════════════════

# ── Server ──────────────────────────────────
PORT=3000

# Public base URL (used in email links — NO trailing slash)
# Change to your actual domain when deployed
BASE_URL=http://localhost:3000

# ── JWT ─────────────────────────────────────
# Generate a strong secret: node -e "require('crypto').randomBytes(64).toString('hex')|0"
JWT_SECRET=change-this-to-a-long-random-secret

# ── Gmail SMTP ───────────────────────────────
# Use your team Gmail address
GMAIL_USER=your-email@gmail.com
# Google App Password (NOT your regular Gmail password)
# Enable at: t
# (Requires 2FA to be enabled on the account)
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
